          "evidencePacks": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "policies": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "verificationScope": {
            "const": "public_hash_registry"
          },
          "cryptographicEvidencePackVerified": {
            "const": false
          },
          "limitation": {
            "type": "string"
          },
          "trace_id": {
            "type": "string"
          }
        },
        "additionalProperties": true
      },
      "EvidencePackVerifyRequest": {
        "type": "object",
        "required": [
          "evidencePack"

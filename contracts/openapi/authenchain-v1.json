        "properties": {
          "error": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "pattern": "^[A-Z0-9_]+$"
          },
          "message": {
            "type": "string"
          },
          "trace_id": {
            "type": "string"
          }
        },
        "additionalProperties": true
      },
      "CaptureAssurance": {
        "type": "object",
        "required": [
          "schemaVersion",
          "assuranceLevel",
          "captureMethod",
          "contentObserved",
          "limitations"
        ],
        "properties": {
          "schemaVersion": {
            "const": "authenchain.assurance.v1"
          },
          "assuranceLevel": {
            "type": "string",
            "enum": [
              "A0",
              "A1"
            ]
          },
          "captureMethod": {
            "type": "string",
            "enum": [
              "attest_submitted_hash",
              "observe_submitted_content"
            ]
          },
          "contentObserved": {
            "type": "boolean"
          },
          "limitations": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            }
          }
        },
        "oneOf": [
          {
            "properties": {
              "assuranceLevel": {
                "const": "A0"
              },
              "captureMethod": {
                "const": "attest_submitted_hash"
              },
              "contentObserved": {
                "const": false
              }
            }
          },
          {
            "properties": {
              "assuranceLevel": {
                "const": "A1"
              },
              "captureMethod": {
                "const": "observe_submitted_content"
              },
              "contentObserved": {
                "const": true
              }
            }
          }
        ],
        "additionalProperties": false,
        "description": "Authenticated only after signature and key trust checks. A2–A4 are reserved and are not issued by this endpoint. No level establishes legal compliance."
      },

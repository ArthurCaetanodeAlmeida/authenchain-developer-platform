        "properties": {
          "trustedStatus": {
            "type": "string",
            "enum": [
              "trusted",
              "untrusted",
              "failed"
            ]
          },
          "externallyTrustworthy": {
            "type": "boolean"
          },
          "trustedStatusReason": {
            "type": [
              "string",
              "null"
            ]
          },
          "trace_id": {
            "type": "string"
          },
          "captureAssurance": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "assurance_level",
                "capture_method",
                "content_observed",
                "authenticated",
                "limitations"
              ],
              "properties": {
                "schema_version": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "assurance_level": {
                  "type": "string",
                  "enum": [
                    "A0",
                    "A1",
                    "unknown"
                  ]
                },
                "capture_method": {
                  "type": "string",
                  "enum": [
                    "attest_submitted_hash",
                    "observe_submitted_content",
                    "unknown"
                  ]
                },
                "content_observed": {
                  "type": [
                    "boolean",
                    "null"
                  ]
                },
                "authenticated": {
                  "type": "boolean"
                },
                "declared_assurance_level": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "limitations": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "proofIndex": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "additionalProperties": false
            }
          },
          "proofResults": {
            "type": "array",
            "items": {
              "type": "object",
              "description": "Per-proof checks for structure, linkage, signature, payload hash, audit chain, anchor, publication, content and regulatory evidence. unknown/not_checked remain explicit.",
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      },
      "TrustRoot": {
        "type": "object",
        "required": [
          "version",
          "issuer",
          "keys"

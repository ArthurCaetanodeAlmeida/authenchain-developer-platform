            ]
          },
          "content_observed": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "authenticated": {
            "type": "boolean"
          },
          "declared_assurance_level": {
            "type": [
              "string",
              "null"
            ]
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    }
  }

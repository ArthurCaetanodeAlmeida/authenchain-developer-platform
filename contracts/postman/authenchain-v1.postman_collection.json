            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"content_hash\": \"{{contentHash}}\",\n  \"metadata\": {\n    \"issuer\": \"postman-sandbox\"\n  },\n  \"signature\": \"{{signature}}\",\n  \"public_key_id\": \"{{publicKeyId}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/provenance/verify",
